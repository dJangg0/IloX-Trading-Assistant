# Copy to server/.env and fill in. server/.env is gitignored.

PORT=3001
HOST=127.0.0.1

# Required (>= 16 chars). Sent by the browser as X-Admin-Token for every admin action.
ADMIN_TOKEN=

# Required. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

DB_PATH=./data/bandalert.db

# simulated = random-walk feed for development.
# sifting   = live commodities (XAUUSD etc.) from api.sifting.io + stream.sifting.io. Needs SIFTING_API_KEY.
# custom    = your provider (server/src/adapters/customFeedAdapter.ts)
FEED_ADAPTER=simulated
SIM_TICK_MS=1000
SIM_VOLATILITY=0.0005
SIFTING_API_KEY=

# Allowed origins for cross-origin calls. Not needed when the Vite dev proxy or same-origin static serving is used.
CORS_ORIGIN=http://localhost:5173
